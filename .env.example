# Optional keys. Copy this file to .env (npm run setup does it) and fill in only what you use.
# .env is git-ignored: it never leaves your computer.

# ElevenLabs voices (best quality, exact word timings): elevenlabs.io > Profile > API keys
ELEVENLABS_API_KEY=

# OpenAI voices and Whisper voice checks: platform.openai.com > API keys
OPENAI_API_KEY=

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tradient:production-script:1",
  "title": "ProductionScript v1",
  "description": "Editorial instructions plus pinned scene recipes. Native recipes remain code; no arbitrary code evaluation is accepted in this document.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "composition",
    "shots",
    "render",
    "fonts",
    "finish",
    "audio",
    "phone",
    "supplemental",
    "layers",
    "assetManifest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "composition": {
      "type": "object",
      "required": [
        "id",
        "width",
        "height",
        "fps",
        "durationInFrames"
      ],
      "properties": {
        "id": {
          "const": "ProductionScriptReplay"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "integer",
          "minimum": 1
        },
        "durationInFrames": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "component",
          "scene",
          "start",
          "end",
          "clock",
          "resetKey",
          "handoff",
          "parameters"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "component": {
            "enum": [
              "physical",
              "globe"
            ]
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "clock": {
            "type": "object",
            "required": [
              "globalOffset",
              "localOrigin",
              "masterFrameOffset"
            ]
          },
          "parameters": {
            "type": "object"
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "static",
              "metric",
              "timer",
              "packet-count",
              "photo-leader",
              "image",
              "arrival-count",
              "photo-mosaic",
              "captions"
            ]
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "asset",
        "startFrame",
        "gain"
      ],
      "properties": {
        "asset": {
          "type": "string"
        },
        "startFrame": {
          "type": "integer",
          "minimum": 0
        },
        "gain": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "assetManifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ]
      }
    },
    "seconds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "second",
          "startFrame",
          "endFrameInclusive",
          "shots",
          "narration",
          "constructionBeats",
          "sound",
          "continuity"
        ]
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "family"
        ]
      }
    },
    "captureProfile": {
      "type": "object",
      "required": [
        "id",
        "gl",
        "canvasProfile",
        "workers",
        "fromSurface",
        "browserSha256"
      ],
      "properties": {
        "canvasProfile": {
          "enum": [
            "native",
            "cpu-preserved"
          ]
        },
        "workers": {
          "enum": [
            1,
            2
          ]
        },
        "fromSurface": {
          "const": true
        },
        "browserSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
